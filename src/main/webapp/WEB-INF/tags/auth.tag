<%@ tag pageEncoding="UTF-8" %><%@ attribute name="titulo" required="true" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %>
<!doctype html><html lang="pt-MZ"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out value="${titulo}"/> · AgroGest</title><link rel="icon" href="${cp}/assets/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="${cp}/assets/style.css?v=1.2.3"><script defer src="${cp}/assets/login.js?v=1.2.2"></script></head><body class="auth-page"><div class="auth-visual"><a class="brand" href="${cp}/login"><span class="brand-mark"><t:icone nome="folha"/></span>Agro<span>Gest</span></a><div class="auth-headline"><span class="eyebrow">DA TERRA AO FUTURO</span><h1>Cultivar melhor.<br>Gerir com<br><em>clareza.</em></h1><p>Campanhas, colheitas e comércio.<br>Tudo no mesmo lugar.</p></div><img src="${cp}/assets/img/campo.svg" alt="Ilustração de campos agrícolas com um sol nascente"><div class="auth-location">NAMPULA, MOÇAMBIQUE <span>●</span> AGROGEST</div></div><main class="auth-main"><div class="auth-card"><a class="brand auth-mobile-brand" href="${cp}/login"><span class="brand-mark"><t:icone nome="folha"/></span>Agro<span>Gest</span></a><span class="eyebrow green">BEM-VINDO AO AGROGEST</span><h1><c:out value="${titulo}"/></h1><c:if test="${not empty erro}"><div class="alert error" role="alert"><c:out value="${erro}"/></div></c:if><jsp:doBody/></div><p class="auth-footer">Crescer começa com uma boa gestão.</p></main></body></html>
