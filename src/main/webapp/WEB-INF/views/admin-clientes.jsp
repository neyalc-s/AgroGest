<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Clientes"><div class="page-title"><div><span class="eyebrow">QUEM CRESCE CONSIGO</span><h1>Clientes</h1><p>Contas de cliente registadas no AgroGest.</p></div><a class="btn secondary small" href="${cp}/admin/relatorios">Ver relatórios →</a></div><t:ordem campos="nome,email,data"/><section class="panel"><div class="table-wrap"><table><thead><tr><th scope="col">Nome</th><th scope="col">Email</th><th scope="col">Telefone</th><th scope="col">Endereço</th><th scope="col">Registo</th></tr></thead><tbody><c:forEach items="${clientes}" var="c"><tr><td><strong><c:out value="${c.nome}"/></strong><small>#${c.id}</small></td><td><c:out value="${c.email}"/></td><td><c:out value="${c.telefone}"/></td><td class="wrap"><c:out value="${c.endereco}"/></td><td>${ag:data(c.criadoEm)}</td></tr></c:forEach><c:if test="${empty clientes}"><tr><td colspan="5" class="empty">Ainda não existem contas de cliente.</td></tr></c:if></tbody></table></div></section></t:layout>
