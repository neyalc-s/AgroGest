<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!doctype html><html lang="pt-MZ"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pedido não concluído · AgroGest</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><main class="error-page"><div class="error-code"><c:out value="${requestScope['jakarta.servlet.error.status_code']}"/></div><h1>Pedido não concluído.</h1><c:choose><c:when test="${requestScope['jakarta.servlet.error.status_code'] == 403}"><p>Não tem permissão para aceder a este recurso, ou o formulário expirou. Reabra a página e tente novamente.</p></c:when><c:when test="${requestScope['jakarta.servlet.error.status_code'] == 404}"><p>O recurso procurado não existe.</p></c:when><c:when test="${requestScope['jakarta.servlet.error.status_code'] == 400}"><p>O pedido contém dados inválidos.</p></c:when><c:otherwise><p>Ocorreu um erro ao processar o pedido. Consulte os logs do servidor.</p></c:otherwise></c:choose><a class="btn" href="${pageContext.request.contextPath}/inicio">Voltar ao início</a></main></body></html>
