<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %>
<t:auth titulo="Criar conta de cliente"><p class="muted">Encontre o que precisa para a próxima campanha.</p><form method="post" action="${cp}/registo" class="stack"><t:csrf/><label>Nome completo<input name="nome" value="<c:out value='${param.nome}'/>" maxlength="100" autocomplete="name" required></label><label>Email<input type="email" name="email" value="<c:out value='${param.email}'/>" maxlength="160" autocomplete="email" required></label><div class="form-grid"><label>Telefone<input type="tel" name="telefone" value="<c:out value='${param.telefone}'/>" maxlength="30" autocomplete="tel" required></label><label>Endereço<input name="endereco" value="<c:out value='${param.endereco}'/>" maxlength="240" autocomplete="street-address" required></label></div><div class="form-grid"><label>Palavra-passe<input type="password" name="senha" minlength="4" maxlength="128" autocomplete="new-password" required></label><label>Confirmar palavra-passe<input type="password" name="confirmacao" minlength="4" maxlength="128" autocomplete="new-password" required></label></div><small class="muted">Mínimo de 4 caracteres. O email deve ser único.</small><button class="btn full">Criar a minha conta →</button></form><p class="auth-switch">Já tem uma conta? <a href="${cp}/login">Entrar</a></p></t:auth>
