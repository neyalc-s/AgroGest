<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Cultivos"><div class="page-title"><div><span class="eyebrow">O QUE ESTÁ A CRESCER</span><h1>Cultivos</h1><p>Registe a cultura, a variedade e a área de cada plantio.</p></div></div><details class="panel"><summary>Registar cultivo</summary><div class="panel-body"><c:choose><c:when test="${empty campanhas}"><p>Crie primeiro uma campanha agrícola.</p><a class="btn" href="${cp}/admin/campanhas">Ir às campanhas</a></c:when><c:otherwise><form method="post" action="${cp}/admin/cultivos"><t:csrf/><input type="hidden" name="acao" value="criar"><div class="form-grid"><label>Campanha<select name="campanhaId"><c:forEach items="${campanhas}" var="c"><option value="${c.id}" ${c.fechada ? 'disabled' : ''}><c:out value="${c.nome}"/>${c.fechada ? ' (fechada)' : ''}</option></c:forEach></select></label><label>Cultura<input name="cultura" maxlength="120" placeholder="Feijão nhemba" required></label><label>Variedade<input name="variedade" maxlength="120" placeholder="Macia" required></label><label>Área (hectares)<input type="number" name="hectares" min="0.001" max="999999999" step="0.001" required></label><label>Data de plantio<input type="date" name="plantio" required></label></div><div class="form-footer"><button class="btn">Registar cultivo</button></div></form></c:otherwise></c:choose></div></details><t:ordem campos="nome,data,hectares"/><section class="panel"><div class="table-wrap"><table><thead><tr><th>Cultura / variedade</th><th>Campanha</th><th class="num">Área (ha)</th><th>Plantio</th><th>Acções</th></tr></thead><tbody><c:forEach items="${cultivos}" var="c"><tr><td><strong><c:out value="${c.cultura}"/></strong><small><c:out value="${c.variedade}"/> · #${c.id}</small></td><td><c:out value="${c.campanhaNome}"/></td><td class="num">${ag:qtd(c.hectares)}</td><td>${ag:data(c.plantio)}</td><td><form method="post" action="${cp}/admin/cultivos" data-confirm="Remover este cultivo?"><t:csrf/><input type="hidden" name="acao" value="remover"><input type="hidden" name="id" value="${c.id}"><button class="btn small danger">Remover</button></form></td></tr></c:forEach><c:if test="${empty cultivos}"><tr><td colspan="5" class="empty">Ainda não existem cultivos.</td></tr></c:if></tbody></table></div></section><div class="info-box">O plantio deve ocorrer dentro do período da campanha. Um cultivo com colheitas associadas não pode ser removido.</div></t:layout>
