<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Minhas compras"><div class="page-title"><div><span class="eyebrow">O SEU PERCURSO CONNOSCO</span><h1>Minhas compras</h1><p>Consulte e imprima as facturas das suas compras anteriores.</p></div><a class="btn secondary small" href="${cp}/catalogo">Voltar ao catálogo →</a></div><section class="panel"><div class="table-wrap"><table><thead><tr><th scope="col">Factura</th><th scope="col">Data</th><th scope="col" class="num">Subtotal</th><th scope="col" class="num">IVA 16%</th><th scope="col" class="num">Total</th><th scope="col">Detalhes</th></tr></thead><tbody><c:forEach items="${vendas}" var="v"><tr><td><strong><c:out value="${v.numero}"/></strong></td><td>${ag:data(v.data)}</td><td class="num">${ag:moeda(v.subtotal)} MT</td><td class="num">${ag:moeda(v.iva)} MT</td><td class="num"><strong>${ag:moeda(v.total)} MT</strong></td><td><a class="btn small secondary" href="${cp}/factura?id=${v.id}">Ver factura</a></td></tr></c:forEach><c:if test="${empty vendas}"><tr><td colspan="6" class="empty">Ainda não tem compras. Visite o catálogo para começar.</td></tr></c:if></tbody></table></div></section></t:layout>
