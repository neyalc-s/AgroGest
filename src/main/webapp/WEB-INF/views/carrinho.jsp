<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Meu carrinho"><div class="page-title"><div><span class="eyebrow">QUASE NO PONTO</span><h1>O seu carrinho</h1><p>Confira os produtos e ajuste as quantidades antes de continuar.</p></div><a class="btn secondary small" href="${cp}/catalogo">← Continuar a escolher</a></div><c:choose><c:when test="${empty linhas}"><div class="panel empty"><t:icone nome="carrinho"/><h2>Ainda há espaço para crescer.</h2><p>Escolha os primeiros produtos no catálogo.</p><a class="btn" href="${cp}/catalogo">Explorar catálogo</a></div></c:when><c:otherwise><div class="cart-layout"><section class="panel"><div class="table-wrap"><table><thead><tr><th scope="col">Produto</th><th scope="col" class="num">Preço / unidade</th><th scope="col">Quantidade</th><th scope="col" class="num">Subtotal</th><th scope="col"></th></tr></thead><tbody><c:forEach items="${linhas}" var="l"><tr><td><strong><c:out value="${l.nome}"/></strong><small>${ag:qtd(l.stock)} <c:out value="${l.unidade}"/> disponíveis</small></td><td class="num">${ag:moeda(l.preco)} MT</td><td><form class="inline-actions" method="post" action="${cp}/carrinho/atualizar"><t:csrf/><input type="hidden" name="acao" value="atualizar"><input type="hidden" name="id" value="${l.produtoId}"><input type="number" name="quantidade" aria-label="Quantidade de <c:out value='${l.nome}'/>" value="${l.quantidade}" min="0.001" step="0.001" required><button class="btn small secondary">Actualizar</button></form></td><td class="num">${ag:moeda(l.subtotal)} MT</td><td><form method="post" action="${cp}/carrinho/remover"><t:csrf/><input type="hidden" name="acao" value="remover"><input type="hidden" name="id" value="${l.produtoId}"><button class="btn small danger">Remover</button></form></td></tr></c:forEach></tbody></table></div><div class="panel-body"><form method="post" action="${cp}/carrinho/esvaziar" data-confirm="Esvaziar o carrinho?"><t:csrf/><input type="hidden" name="acao" value="esvaziar"><button class="btn small secondary">Esvaziar carrinho</button></form></div></section><section class="panel"><div class="panel-header"><h2>Resumo</h2></div><div class="panel-body"><div class="summary-row"><span>Subtotal</span><strong>${ag:moeda(subtotal)} MT</strong></div><div class="summary-row"><span>IVA (16%)</span><strong>${ag:moeda(iva)} MT</strong></div><div class="summary-row total"><span>Total</span><strong>${ag:moeda(total)} MT</strong></div><p class="purchase-note">O stock e os preços serão conferidos novamente ao confirmar a compra.</p><a class="btn full" href="${cp}/compra">Finalizar compra →</a></div></section></div></c:otherwise></c:choose></t:layout>
