<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Visão geral">
<div class="page-title"><div><span class="eyebrow">O SEU CAMPO, NUM SÓ OLHAR</span><h1>Vamos fazer crescer.</h1><p>Acompanhe a actividade agrícola e as vendas do seu negócio.</p></div><a class="btn secondary small" href="${cp}/catalogo"><t:icone nome="folha"/>Ver catálogo</a></div>
<section class="hero"><div class="hero-content"><span class="eyebrow">GESTÃO AGRÍCOLA</span><h2>Boas decisões.<br>Melhores colheitas.</h2><p>Organize cada campanha, cuide do stock e acompanhe quem compra consigo.</p><a class="btn small" href="${cp}/admin/campanhas">Explorar campanhas →</a></div><img src="${cp}/assets/img/campo.svg" alt="Campos agrícolas ilustrados"></section>
<div class="stats"><div class="stat money"><span>Volume de vendas</span><div class="stat-icon"><t:icone nome="grafico"/></div><strong>${ag:moeda(totalVendas)} <small>MT</small></strong><small>${numVendas} compras · IVA incluído</small></div><div class="stat"><span>Produtos</span><div class="stat-icon"><t:icone nome="caixa"/></div><strong>${numProdutos}</strong><small>no catálogo</small></div><div class="stat"><span>Clientes</span><div class="stat-icon"><t:icone nome="pessoa"/></div><strong>${numClientes}</strong><small>contas de cliente</small></div><div class="stat"><span>Campanhas</span><div class="stat-icon"><t:icone nome="calendario"/></div><strong>${numCampanhas}</strong><small>${numFornecedores} fornecedores parceiros</small></div></div>
<div class="two-columns"><section class="panel"><div class="panel-header"><div><h2>Últimas compras</h2><p>As movimentações mais recentes.</p></div><a href="${cp}/admin/compras">Ver todas →</a></div><div class="table-wrap"><table><thead><tr><th>Factura</th><th>Cliente</th><th class="num">Total</th></tr></thead><tbody><c:forEach items="${recentes}" var="v"><tr><td><a href="${cp}/factura?id=${v.id}"><strong><c:out value="${v.numero}"/></strong></a><small>${ag:data(v.data)}</small></td><td><c:out value="${v.clienteNome}"/></td><td class="num">${ag:moeda(v.total)} MT</td></tr></c:forEach><c:if test="${empty recentes}"><tr><td colspan="3" class="empty">Ainda não há compras.</td></tr></c:if></tbody></table></div></section><div class="stack dashboard-side"><section class="panel"><div class="panel-header"><h2>As suas campanhas</h2><t:icone nome="campo"/></div><div class="summary-list"><c:forEach items="${campanhas}" var="c"><div class="summary-row"><div><strong><c:out value="${c.nome}"/></strong><br><small class="muted">${ag:data(c.inicio)} → ${ag:data(c.fim)}</small></div><span class="badge ${c.fechada ? 'gray' : ''}">${c.fechada ? 'Fechada' : 'Aberta'}</span></div></c:forEach><c:if test="${empty campanhas}"><p class="muted">Crie a sua primeira campanha.</p></c:if></div></section>
<div class="quick-links dashboard-actions"><a class="quick-card" href="${cp}/admin/produtos"><t:icone nome="caixa"/><strong>Gerir o catálogo</strong><p>Produtos, preços e reposição de stock.</p></a><a class="quick-card" href="${cp}/admin/colheitas"><t:icone nome="campo"/><strong>Registar uma colheita</strong><p>Do cultivo ao valor produzido.</p></a><a class="quick-card" href="${cp}/admin/relatorios"><t:icone nome="grafico"/><strong>Conhecer os clientes</strong><p>Volume de compras e assiduidade.</p></a></div></div></div>
</t:layout>
