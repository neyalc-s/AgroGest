<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="${menu == 'armazem' ? 'Armazém' : 'Produtos'}"><div class="page-title"><div><span class="eyebrow">CATÁLOGO E STOCK</span><h1>${menu == 'armazem' ? 'O que há em armazém.' : 'Produtos'}</h1><p>${menu == 'armazem' ? 'Apenas produtos com stock superior a zero.' : 'Mantenha os preços, as quantidades e os detalhes em dia.'}</p></div><a class="btn secondary small" href="${cp}/catalogo">Ver catálogo →</a></div>
<c:if test="${menu != 'armazem'}"><details class="panel" ${not empty editar ? 'open' : ''}><summary>${empty editar ? 'Adicionar produto' : 'Editar produto'}</summary><div class="panel-body"><c:choose><c:when test="${empty fornecedores}"><p>Crie primeiro um fornecedor.</p><a class="btn" href="${cp}/admin/fornecedores">Ir aos fornecedores</a></c:when><c:otherwise><form method="post" action="${cp}/admin/produtos"><t:csrf/><input type="hidden" name="acao" value="guardar"><input type="hidden" name="id" value="${editar.id}"><input type="hidden" name="versao" value="${editar.versao}"><div class="form-grid three"><label>Nome<input name="nome" value="<c:out value='${editar.nome}'/>" maxlength="120" required></label><label>Categoria<select name="categoria"><c:forEach items="${categorias}" var="cat"><option value="${cat}" ${editar.categoria == cat ? 'selected' : ''}>${cat}</option></c:forEach></select></label><label>Fornecedor<select name="fornecedorId"><c:forEach items="${fornecedores}" var="f"><option value="${f.id}" ${editar.fornecedorId == f.id ? 'selected' : ''}><c:out value="${f.nome}"/></option></c:forEach></select></label><label>Preço sem IVA (MT)<input type="number" name="preco" value="${editar.preco}" min="0.01" max="999999999" step="0.01" required></label><label>Stock actual<input type="number" name="quantidade" value="${empty editar ? '0' : editar.quantidade}" min="0" max="999999999" step="0.001" required></label><label>Unidade<input name="unidade" value="<c:out value='${editar.unidade}'/>" placeholder="kg, saco, unidade..." maxlength="30" required></label><label>Validade (opcional)<input type="date" name="validade" value="${editar.validade}"></label><label class="wide">Foto: URL HTTP/HTTPS (opcional)<input name="foto" value="<c:out value='${editar.foto}'/>" maxlength="1500" placeholder="Deixe vazio para usar a ilustração da categoria"></label><label class="wide">Descrição<textarea name="descricao" maxlength="1000" required><c:out value="${editar.descricao}"/></textarea></label></div><div class="form-footer"><small>Até 3 casas decimais no stock; 2 no preço.</small><c:if test="${not empty editar}"><a class="btn secondary" href="${cp}/admin/produtos">Cancelar edição</a></c:if><button class="btn">Guardar produto</button></div></form></c:otherwise></c:choose></div></details></c:if>
<t:ordem campos="nome,preco,stock,data"/><section class="panel"><div class="table-wrap"><table><thead><tr><th scope="col">Produto / fornecedor</th><th scope="col">Categoria</th><th scope="col" class="num">Preço s/ IVA</th><th scope="col" class="num">Stock</th><th scope="col">Validade</th><th scope="col">Acções</th></tr></thead><tbody><c:forEach items="${produtos}" var="p"><tr><td><strong><c:out value="${p.nome}"/></strong><small><c:out value="${p.fornecedorNome}"/> · #${p.id}</small></td><td><span class="badge">${p.categoria}</span></td><td class="num">${ag:moeda(p.preco)} MT</td><td class="num"><strong>${ag:qtd(p.quantidade)}</strong> <c:out value="${p.unidade}"/><small><span class="badge ${p.quantidade <= 0 ? 'red' : ''}">${p.quantidade <= 0 ? 'Sem stock' : 'Disponível'}</span></small></td><td><span class="${p.expirado ? 'badge red' : ''}">${ag:data(p.validade)}${p.expirado ? ' · Expirada' : ''}</span></td><td><div class="inline-actions"><a class="btn small secondary" href="${cp}/admin/produtos?editar=${p.id}">Editar</a><form class="inline-actions" method="post" action="${cp}/admin/produtos"><t:csrf/><input type="hidden" name="acao" value="repor"><input type="hidden" name="id" value="${p.id}"><input type="number" name="quantidade" aria-label="Quantidade a repor em <c:out value='${p.nome}'/>" min="0.001" step="0.001" placeholder="+ stock" required><button class="btn small secondary">Repor</button></form><form method="post" action="${cp}/admin/produtos" data-confirm="Remover o produto? As facturas anteriores serão conservadas."><t:csrf/><input type="hidden" name="acao" value="remover"><input type="hidden" name="id" value="${p.id}"><button class="btn small danger">Remover</button></form></div></td></tr></c:forEach><c:if test="${empty produtos}"><tr><td colspan="6" class="empty">Não existem produtos nesta listagem.</td></tr></c:if></tbody></table></div></section><div class="info-box">A reposição soma a quantidade indicada ao stock existente. A edição permite definir o stock total. A ordenação por data usa a validade.</div></t:layout>
