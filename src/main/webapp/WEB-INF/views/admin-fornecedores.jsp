<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Fornecedores"><div class="page-title"><div><span class="eyebrow">PARCEIROS DO CAMPO</span><h1>Fornecedores</h1><p>As origens de tudo o que chega ao seu catálogo.</p></div></div>
<details class="panel"><summary>Adicionar fornecedor</summary><div class="panel-body"><form method="post" action="${cp}/admin/fornecedores"><t:csrf/><input type="hidden" name="acao" value="criar"><div class="form-grid"><label>Nome<input name="nome" maxlength="120" required></label><label>Tipo<select name="tipo"><c:forEach items="${tipos}" var="tipo"><option value="${tipo}">${tipo}</option></c:forEach></select></label><label>Contacto<input name="contacto" maxlength="80" required></label><label>Província<input name="provincia" maxlength="80" placeholder="Ex.: Nampula" required></label></div><div class="form-footer"><button class="btn">Criar fornecedor</button></div></form></div></details>
<t:ordem campos="nome,provincia,tipo"/><section class="panel"><div class="table-wrap"><table><thead><tr><th>Fornecedor</th><th>Tipo</th><th>Contacto</th><th>Província</th><th>Acções</th></tr></thead><tbody><c:forEach items="${fornecedores}" var="f"><tr><td><strong><c:out value="${f.nome}"/></strong><small>#${f.id}</small></td><td><span class="badge">${f.tipo}</span></td><td><c:out value="${f.contacto}"/></td><td><c:out value="${f.provincia}"/></td><td><form method="post" action="${cp}/admin/fornecedores" data-confirm="Remover este fornecedor?"><t:csrf/><input type="hidden" name="acao" value="remover"><input type="hidden" name="id" value="${f.id}"><button class="btn small danger">Remover</button></form></td></tr></c:forEach><c:if test="${empty fornecedores}"><tr><td colspan="5" class="empty">Ainda não existem fornecedores. Adicione o primeiro.</td></tr></c:if></tbody></table></div></section><div class="info-box">Um fornecedor com produtos associados só pode ser removido depois de remover esses produtos.</div></t:layout>
