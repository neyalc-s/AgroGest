<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Compras"><div class="page-title"><div><span class="eyebrow">CADA VENDA, EM DETALHE</span><h1>Compras efectuadas</h1><p>Abra uma factura para consultar o cliente, endereço, telefone e todos os itens.</p></div></div><t:ordem campos="data,valor,nome"/><section class="panel"><div class="table-wrap"><table><thead><tr><th>Factura</th><th>Cliente</th><th>Data</th><th class="num">Subtotal</th><th class="num">IVA 16%</th><th class="num">Total</th><th>Detalhes</th></tr></thead><tbody><c:forEach items="${vendas}" var="v"><tr><td><strong><c:out value="${v.numero}"/></strong></td><td><c:out value="${v.clienteNome}"/><small><c:out value="${v.clienteEmail}"/></small></td><td>${ag:data(v.data)}</td><td class="num">${ag:moeda(v.subtotal)} MT</td><td class="num">${ag:moeda(v.iva)} MT</td><td class="num"><strong>${ag:moeda(v.total)} MT</strong></td><td><a class="btn small secondary" href="${cp}/factura?id=${v.id}">Ver factura</a></td></tr></c:forEach><c:if test="${empty vendas}"><tr><td colspan="7" class="empty">Ainda não existem compras.</td></tr></c:if></tbody></table></div></section></t:layout>
