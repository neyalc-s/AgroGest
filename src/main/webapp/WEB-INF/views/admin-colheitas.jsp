<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Colheitas"><div class="page-title"><div><span class="eyebrow">O RESULTADO DO SEU CAMPO</span><h1>Colheitas</h1><p>Acompanhe a quantidade produzida e o seu valor.</p></div></div><details class="panel"><summary>Registar colheita</summary><div class="panel-body"><c:choose><c:when test="${empty cultivos}"><p>Registe primeiro um cultivo.</p><a class="btn" href="${cp}/admin/cultivos">Ir aos cultivos</a></c:when><c:otherwise><form method="post" action="${cp}/admin/colheitas"><t:csrf/><input type="hidden" name="acao" value="criar"><div class="form-grid"><label>Cultivo<select name="cultivoId"><c:forEach items="${cultivos}" var="c"><option value="${c.id}"><c:out value="${c.cultura}"/> · <c:out value="${c.campanhaNome}"/> (#${c.id})</option></c:forEach></select></label><label>Data de colheita<input type="date" name="data" required></label><label>Quantidade (kg)<input type="number" name="quantidade" min="0.001" max="999999999" step="0.001" required></label><label>Preço por kg (MT)<input type="number" name="precoKg" min="0.01" max="999999999" step="0.01" required></label></div><div class="form-footer"><small>Valor total = quantidade × preço por kg.</small><button class="btn">Registar colheita</button></div></form></c:otherwise></c:choose></div></details><t:ordem campos="data,quantidade,valor"/><section class="panel"><div class="table-wrap"><table><thead><tr><th scope="col">Cultivo</th><th scope="col">Data</th><th scope="col" class="num">Quantidade (kg)</th><th scope="col" class="num">Preço / kg</th><th scope="col" class="num">Total</th></tr></thead><tbody><c:forEach items="${colheitas}" var="c"><tr><td><strong><c:out value="${c.cultura}"/></strong><small>Cultivo #${c.cultivoId} · Colheita #${c.id}</small></td><td>${ag:data(c.data)}</td><td class="num">${ag:qtd(c.quantidade)}</td><td class="num">${ag:moeda(c.precoKg)} MT</td><td class="num"><strong>${ag:moeda(c.total)} MT</strong></td></tr></c:forEach><c:if test="${empty colheitas}"><tr><td colspan="5" class="empty">Ainda não existem colheitas registadas.</td></tr></c:if></tbody></table></div></section><div class="info-box">As colheitas registam a produção agrícola. Não aumentam automaticamente o stock comercial: o enunciado trata os dois módulos separadamente.</div></t:layout>
