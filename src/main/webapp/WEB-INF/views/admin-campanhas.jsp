<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Campanhas"><div class="page-title"><div><span class="eyebrow">CADA ÉPOCA, UM PLANO</span><h1>Campanhas agrícolas</h1><p>Defina as datas e acompanhe cada ciclo de produção.</p></div></div><details class="panel"><summary>Nova campanha</summary><div class="panel-body"><form method="post" action="${cp}/admin/campanhas"><t:csrf/><input type="hidden" name="acao" value="criar"><div class="form-grid three"><label>Nome<input name="nome" maxlength="120" placeholder="Campanha 2026/2027" required></label><label>Data de início<input name="inicio" type="date" required></label><label>Data de fim<input name="fim" type="date" required></label></div><div class="form-footer"><button class="btn">Criar campanha</button></div></form></div></details><t:ordem campos="nome,data"/><section class="panel"><div class="table-wrap"><table><thead><tr><th scope="col">Campanha</th><th scope="col">Período</th><th scope="col">Estado</th><th scope="col">Acções</th></tr></thead><tbody><c:forEach items="${campanhas}" var="c"><tr><td><strong><c:out value="${c.nome}"/></strong><small>#${c.id}</small></td><td>${ag:data(c.inicio)} → ${ag:data(c.fim)}</td><td><span class="badge ${c.fechada ? 'gray' : ''}">${c.fechada ? 'Fechada' : 'Aberta'}</span></td><td><div class="inline-actions"><form method="post" action="${cp}/admin/campanhas"><t:csrf/><input type="hidden" name="id" value="${c.id}"><input type="hidden" name="acao" value="${c.fechada ? 'reabrir' : 'fechar'}"><button class="btn small secondary">${c.fechada ? 'Reabrir' : 'Fechar'}</button></form><form method="post" action="${cp}/admin/campanhas" data-confirm="Remover esta campanha?"><t:csrf/><input type="hidden" name="id" value="${c.id}"><input type="hidden" name="acao" value="remover"><button class="btn small danger">Remover</button></form></div></td></tr></c:forEach><c:if test="${empty campanhas}"><tr><td colspan="4" class="empty">Crie uma campanha para começar.</td></tr></c:if></tbody></table></div></section><div class="info-box">Campanhas com cultivos não podem ser removidas. Fechar uma campanha impede novos cultivos e colheitas; reabra-a para continuar a registar.</div></t:layout>
