<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="t" tagdir="/WEB-INF/tags" %><%@ taglib prefix="ag" uri="agrogest-formatos" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<t:layout titulo="Factura"><div class="invoice-actions"><a class="btn secondary small" href="${cp}${utilizador.perfil == 'ADMIN' ? '/admin/compras' : '/minhas-compras'}">← Voltar às compras</a><button class="btn small" type="button" data-print><t:icone nome="recibo"/>Imprimir factura</button></div><article class="invoice"><header class="invoice-head"><div><div class="brand"><span class="brand-mark"><t:icone nome="folha"/></span>Agro<span>Gest</span></div><p class="muted" style="font-size:11px;margin:12px 0 0">Sistema de Gestão Agrícola<br>Nampula, Moçambique</p></div><div class="invoice-title"><h1>FACTURA</h1><strong><c:out value="${venda.numero}"/></strong><small>Emissão: ${ag:data(venda.data)}</small></div></header><div class="invoice-addresses"><div><h3>FACTURADO A</h3><p><strong><c:out value="${venda.clienteNome}"/></strong></p><p><c:out value="${venda.clienteEndereco}"/></p><p>Telefone: <c:out value="${venda.clienteTelefone}"/></p><p><c:out value="${venda.clienteEmail}"/></p></div><div><h3>INFORMAÇÃO DA COMPRA</h3><p>Referência: #${venda.id}</p><p>Moeda: metical (MZN / MT)</p><p>IVA aplicado: 16%</p></div></div><div class="table-wrap"><table><thead><tr><th>Produto</th><th class="num">Quantidade</th><th>Unidade</th><th class="num">Preço unitário</th><th class="num">Subtotal</th></tr></thead><tbody><c:forEach items="${venda.itens}" var="i"><tr><td><strong><c:out value="${i.nome}"/></strong></td><td class="num">${ag:qtd(i.quantidade)}</td><td><c:out value="${i.unidade}"/></td><td class="num">${ag:moeda(i.precoUnitario)} MT</td><td class="num">${ag:moeda(i.subtotal)} MT</td></tr></c:forEach></tbody></table></div><div class="invoice-total"><div class="summary-row"><span>Subtotal</span><strong>${ag:moeda(venda.subtotal)} MT</strong></div><div class="summary-row"><span>IVA (16%)</span><strong>${ag:moeda(venda.iva)} MT</strong></div><div class="summary-row total"><span>Total</span><strong>${ag:moeda(venda.total)} MT</strong></div></div><div class="invoice-foot">Obrigado por crescer connosco.<br>Documento de demonstração académica emitido pelo AgroGest.</div></article></t:layout>
